# Milvus 学习项目配置示例：复制为 .env 后按需修改。
# 所有配置都有合理的默认值，不复制也能运行。

# ---- Milvus 连接 ----
# 留空：每个 demo 使用 data/runs/<demo>/milvus.db（Milvus Lite 本地文件）
# 远程示例：http://127.0.0.1:19530
MILVUS_URI=
# 本地数据根目录。
# 留空：仓库路径含非 ASCII 字符时，自动使用 ~/.milvus_learn_data
#       （Windows 上 FAISS 无法写入中文路径）
# 也可显式指定纯英文目录，例如：C:/Users/<用户名>/milvus_data
MILVUS_DB_DIR=

# ---- 向量化 ----
# 离线伪向量维度
PSEUDO_EMBED_DIM=256
# pseudo | openai
EMBEDDING_PROVIDER=pseudo

# ---- 全文检索 ----
# auto | native | manual
BM25_MODE=auto

# ---- 可选：OpenAI 兼容接口（不填写则完全离线） ----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- RAG ----
# offline | openai
RAG_LLM=offline
LLM_TIMEOUT=30

# ---- Web UI ----
UI_PORT=7860
# 1 = 每次启动重建 UI 的向量索引
UI_RESET=0
GRADIO_ANALYTICS_ENABLED=False
